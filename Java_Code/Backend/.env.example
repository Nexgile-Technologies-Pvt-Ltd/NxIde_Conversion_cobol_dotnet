# CardDemo backend configuration: reference copy of every key.
#
# The working .env is committed alongside this file, so a fresh clone runs without any setup.
# This template exists to document the keys, including the optional ones .env leaves out, and to
# be the starting point once the committed .env is withdrawn.
#
# Nothing in THIS file may ever hold a live credential.
#
# run-backend.ps1 loads .env into the process environment before starting the application.
# In a real deployment, supply these through the platform's secret store instead.

# --------------------------------------------------------------------------- database
# Required. The application refuses to start without it.
DB_PASSWORD=

# Optional; application.yml already defaults to the configured instance.
# DB_URL=jdbc:postgresql://host:5432/cobol_to_java_app
# DB_USER=cobol_to_java_user

# --------------------------------------------------------------------------- session signing
# Required, at least 32 characters. Generate a fresh random value per environment:
#   pwsh:  -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 64 | % { [char]$_ })
#   bash:  openssl rand -base64 48
# Changing it invalidates every token that has already been issued.
CARDDEMO_JWT_SECRET=

# --------------------------------------------------------------------------- optional
# Password applied to every migrated legacy user; they are expected to change it.
# CARDDEMO_LEGACY_PASSWORD=

# Filesystem path to the original Cobol_Code data directory. Leave unset to use the
# bundled copies under classpath:cobol-data.
# COBOL_DATA_DIR=

# SERVER_PORT=8080
